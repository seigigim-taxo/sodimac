<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- El backend (ws/api) es HTTP plano en la LAN y la app no se publica en
         Play Store: se instala por APK directo en las PDA. Se permite cleartext
         de forma global para no tener que listar cada IP nueva del servidor. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
