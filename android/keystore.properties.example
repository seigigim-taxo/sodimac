# Plantilla para android/keystore.properties
#
# Copiar este archivo como `keystore.properties` (sin .example) y completar con
# los datos reales. Ese archivo y el .jks están en .gitignore: NUNCA se
# commitean.
#
# Crear la llave, una sola vez para todo el proyecto:
#
#   keytool -genkeypair -v -keystore sodimac-release.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 -alias sodimac
#
# ADVERTENCIA
#
# Esta llave no tiene reemplazo. Android exige que la firma coincida para
# actualizar una app instalada, así que si se pierde no se puede volver a
# actualizar ninguna PDA: habría que desinstalar en cada equipo, y eso borra los
# conteos que no se hayan sincronizado.
#
# Guardala fuera del repositorio, con respaldo, y que la conozca más de una
# persona del equipo.

# Ruta al .jks, relativa a la carpeta android/ o absoluta.
storeFile=../sodimac-release.jks

storePassword=CAMBIAR
keyAlias=sodimac
keyPassword=CAMBIAR
